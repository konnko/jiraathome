<Layouts.app flash={@flash}>
  <div class="login-page">
    <section class="login-card card bg-base-100">
      <span class="eyebrow">JIRAATHOME</span>
      <.form for={%{}} action={~p"/login"} id="login-form" class="editor-form">
        <.input
          name="name"
          label="Ваше имя"
          value={@name}
          required
          autocomplete="name"
          autofocus
          errors={if @name_error, do: [@name_error], else: []}
        />
        <.input
          name="password"
          type="password"
          label="Пароль"
          value=""
          required
          autocomplete="current-password"
          errors={if @error, do: [@error], else: []}
        />
        <button type="submit" class="btn btn-primary w-full">Открыть доску
        <span aria-hidden="true">↗</span></button>
      </.form>
    </section>
  </div>
</Layouts.app>
